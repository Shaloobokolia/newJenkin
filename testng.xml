<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="All Test Suite">

    <listeners>
        <listener class-name="listeners.AnnotationTransformer"></listener>
        <listener class-name="listeners.TestExecutionListeners"></listener>
    </listeners>

    <test verbose="2" preserve-order="true"
          name="Bank Manager Tests">
        <classes>
            <class name="tests.BankManagerTests"/>
        </classes>
    </test>

    <test verbose="2" preserve-order="true"
          name="Customer Login Tests">
        <classes>
            <class name="tests.CustomerLoginTests"/>
        </classes>
    </test>
</suite>